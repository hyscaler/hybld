{
  "name": "@hybld/next",
  "version": "1.0.0-beta.2",
  "description": "Next.js render backend and helpers for hybld (scoped static export and merge)",
  "author": "HyScaler",
  "license": "MIT",
  "homepage": "https://github.com/MdMotahir/hybld/tree/development/packages/next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MdMotahir/hybld.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/MdMotahir/hybld/issues"
  },
  "keywords": [
    "hybld",
    "nextjs",
    "static-export",
    "incremental-build",
    "ssg"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "hybld": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
