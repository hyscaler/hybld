{
  "name": "@hybld/adapter-wordpress",
  "version": "1.0.0",
  "description": "WordPress REST adapter preset for hybld",
  "author": "HyScaler",
  "license": "MIT",
  "homepage": "https://github.com/MdMotahir/hybld/tree/development/packages/adapter-wordpress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MdMotahir/hybld.git",
    "directory": "packages/adapter-wordpress"
  },
  "bugs": {
    "url": "https://github.com/MdMotahir/hybld/issues"
  },
  "keywords": [
    "hybld",
    "wordpress",
    "cms-adapter",
    "headless-cms"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "hybld": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
