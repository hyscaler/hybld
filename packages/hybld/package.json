{
  "name": "hybld",
  "version": "1.0.0-beta.2",
  "description": "Incremental and selective static builds for React + Vite projects backed by a headless CMS",
  "author": "HyScaler",
  "license": "MIT",
  "homepage": "https://github.com/MdMotahir/hybld/tree/development/packages/hybld#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MdMotahir/hybld.git",
    "directory": "packages/hybld"
  },
  "bugs": {
    "url": "https://github.com/MdMotahir/hybld/issues"
  },
  "keywords": [
    "static-site-generator",
    "incremental-build",
    "ssg",
    "cms",
    "headless-cms",
    "react",
    "vite",
    "nextjs",
    "astro",
    "jamstack",
    "incremental",
    "wordpress"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "hybld": "./bin/hybld.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jiti": "^2.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
