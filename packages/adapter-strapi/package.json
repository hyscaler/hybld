{
  "name": "@hybld/adapter-strapi",
  "version": "1.0.0-beta.2",
  "description": "Strapi (v4/v5) REST adapter preset for hybld",
  "author": "HyScaler",
  "license": "MIT",
  "homepage": "https://github.com/MdMotahir/hybld/tree/development/packages/adapter-strapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MdMotahir/hybld.git",
    "directory": "packages/adapter-strapi"
  },
  "bugs": {
    "url": "https://github.com/MdMotahir/hybld/issues"
  },
  "keywords": [
