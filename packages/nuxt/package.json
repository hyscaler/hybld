{
  "name": "@hybld/nuxt",
  "version": "1.1.0",
  "description": "Nuxt render backend, module and composable for hybld (scoped build and merge)",
  "author": "HyScaler",
  "license": "MIT",
  "homepage": "https://github.com/hyscaler/hybld/tree/development/packages/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyscaler/hybld.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/hyscaler/hybld/issues"
  },
  "keywords": [
    "hybld",
    "nuxt",
    "vue",
    "incremental-build",
    "ssg"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./runtime/*": "./runtime/*"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "hybld": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
