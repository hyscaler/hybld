---
import { hybldData } from "@hybld/astro";
const { latest } = await hybldData("home");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro Demo (hybld)</title>
    <meta name="description" content="hybld incremental builds on Astro" />
  </head>
  <body>
    <h1>Latest articles (Astro)</h1>
    <ul>
      {latest.map((a: any) => (
        <li>
          <a href={`/articles/${a.slug}/`}>{a.title}</a>
          <small> ({a.date.slice(0, 10)}, <a href={`/category/${a.category}/`}>{a.category}</a>)</small>
        </li>
      ))}
    </ul>
  </body>
</html>
