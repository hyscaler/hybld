---
import { hybldPaths } from "@hybld/astro";

export async function getStaticPaths() {
  return hybldPaths("article", (data, job) => ({
    params: { slug: job.slug! },
    props: { article: data },
  }));
}

const { article } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{article.title} | Astro Demo</title>
    <meta name="description" content={article.excerpt.replace(/<[^>]*>/g, "").slice(0, 150)} />
  </head>
  <body>
    <p><a href="/">Astro Demo</a></p>
    <article>
      <h1>{article.title}</h1>
      <p><small>{article.date.slice(0, 10)} in <a href={`/category/${article.category}/`}>{article.category}</a></small></p>
      <div set:html={article.html} />
    </article>
  </body>
</html>
