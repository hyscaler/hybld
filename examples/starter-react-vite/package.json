{
  "name": "starter-react-vite",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "hybld starter: plain React + Vite against a live public WordPress API (WP Tavern)",
  "scripts": {
    "demo": "hybld build --limit 12 && hybld build --since $(node -e \"console.log(new Date(Date.now()-7*86400000).toISOString())\")",
    "sweep": "hybld build --since last-build",
    "serve": "hybld serve --static --regen",
    "dev": "vite"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@hybld/adapter-wordpress": "^1.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "hybld": "^1.0.0",
    "vite": "^6.0.0"
  }
}
